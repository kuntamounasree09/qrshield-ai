# Required
DATABASE_URL=postgresql://postgres:password@localhost:5432/qrshield
SESSION_SECRET=replace-with-a-long-random-string

# API server
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
API_URL=http://localhost:8080
TRUST_PROXY_HOPS=1
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=900000
SCAN_RATE_LIMIT_MAX=10
SCAN_RATE_LIMIT_WINDOW_MS=900000
MAX_UPLOAD_BYTES=5242880

# Optional AI provider. The core analyzer works without these values.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional threat-intelligence provider. The result is shown separately and
# never changes the deterministic score.
THREAT_INTEL_API_URL=
THREAT_INTEL_API_KEY=
THREAT_INTEL_PROVIDER=